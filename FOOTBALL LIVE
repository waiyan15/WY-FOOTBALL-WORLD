<!DOCTYPE html>
<html lang="my">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WY Football Hub | ဘောလုံး သတင်းနှင့် ရလဒ်များ</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    body {
      background-color: #0b0f19;
      color: #e6edf3;
      padding-bottom: 70px;
    }

    /* Navbar */
    .navbar {
      background: #111827;
      border-bottom: 1px solid #1f2937;
      padding: 14px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      font-size: 18px;
      color: #38bdf8;
    }

    .live-indicator {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      background: rgba(239, 68, 68, 0.15);
      color: #ef4444;
      border: 1px solid #ef4444;
      padding: 3px 8px;
      border-radius: 20px;
      font-weight: bold;
    }

    .live-dot {
      width: 6px;
      height: 6px;
      background: #ef4444;
      border-radius: 50%;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.3; }
      100% { opacity: 1; }
    }

    /* Hero Banner */
    .hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      padding: 24px 20px;
      border-bottom: 1px solid #1f2937;
      text-align: center;
    }

    .hero h1 {
      font-size: 22px;
      margin-bottom: 6px;
      background: linear-gradient(90deg, #38bdf8, #818cf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      font-size: 13px;
      color: #94a3b8;
    }

    /* Container */
    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 16px;
    }

    /* Category Nav Tabs */
    .tab-bar {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .tab-btn {
      background: #161f30;
      color: #94a3b8;
      border: 1px solid #1f293d;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 13px;
      cursor: pointer;
      white-space: nowrap;
      transition: 0.2s;
    }

    .tab-btn.active {
      background: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
    }

    /* Section Headers */
    .section-title {
      font-size: 15px;
      font-weight: 700;
      color: #cbd5e1;
      margin: 18px 0 10px 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Match Cards */
    .match-card {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 14px;
      padding: 14px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: 0.2s;
    }

    .match-card:hover {
      border-color: #38bdf8;
    }

    .team {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      font-size: 13.5px;
      font-weight: 600;
    }

    .team.right {
      justify-content: flex-end;
    }

    .team-badge {
      width: 28px;
      height: 28px;
      background: #1e293b;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
    }

    .score-box {
      background: #0b0f19;
      border: 1px solid #1e293b;
      padding: 6px 14px;
      border-radius: 8px;
      text-align: center;
      min-width: 75px;
      margin: 0 10px;
    }

    .score-text {
      font-size: 16px;
      font-weight: 800;
      color: #38bdf8;
    }

    .match-status {
      font-size: 10px;
      color: #ef4444;
      font-weight: bold;
    }

    /* League Table */
    .table-container {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 14px;
      overflow-x: auto;
      padding: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: center;
    }

    th {
      color: #94a3b8;
      font-size: 11px;
      padding: 8px;
      border-bottom: 1px solid #1f2937;
    }

    td {
      padding: 10px 6px;
      border-bottom: 1px solid #131b2e;
    }

    td.team-col {
      text-align: left;
      font-weight: 600;
    }

    /* News Card */
    .news-card {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 14px;
      overflow: hidden;
      margin-bottom: 12px;
      display: flex;
      gap: 12px;
      padding: 10px;
    }

    .news-thumb {
      width: 100px;
      height: 75px;
      background: #1e293b;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #64748b;
      font-size: 24px;
      flex-shrink: 0;
    }

    .news-info {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .news-tag {
      font-size: 10px;
      color: #38bdf8;
      font-weight: bold;
      margin-bottom: 4px;
    }

    .news-title {
      font-size: 13px;
      line-height: 1.4;
      font-weight: 600;
      color: #cbd5e1;
    }
  </style>
</head>
<body>

  <!-- Top Navbar -->
  <div class="navbar">
    <div class="brand">
      <i class="fa-solid fa-futbol"></i>
      <span>WY FOOTBALL</span>
    </div>
    <div class="live-indicator">
      <span class="live-dot"></span> ၃ ပွဲ ကစားနေဆဲ
    </div>
  </div>

  <!-- Hero Section -->
  <div class="hero">
    <h1>ဘောလုံးပွဲစဉ်နှင့် ရလဒ်များ</h1>
    <p>ယနေ့ ပရီးမီးယားလိဂ်၊ ချန်ပီယံလိဂ် ပွဲစဉ်များနှင့် အပြောင်းအရွှေ့သတင်းများ</p>
  </div>

  <!-- Content Container -->
  <div class="container">

    <!-- Filter Buttons -->
    <div class="tab-bar">
      <button class="tab-btn active" onclick="filterSection('all')">အားလုံး</button>
      <button class="tab-btn" onclick="filterSection('matches')">ပွဲစဉ်များ</button>
      <button class="tab-btn" onclick="filterSection('table')">အမှတ်ပေးဇယား</button>
      <button class="tab-btn" onclick="filterSection('news')">သတင်းများ</button>
    </div>

    <!-- Match Section -->
    <div id="section-matches">
      <div class="section-title">
        <i class="fa-solid fa-circle-play" style="color: #ef4444;"></i> ယနေ့ တိုက်ရိုက်ပွဲစဉ်များ (Live)
      </div>

      <!-- Match 1 -->
      <div class="match-card">
        <div class="team">
          <div class="team-badge">🔴</div>
          <span>Arsenal</span>
        </div>
        <div class="score-box">
          <div class="score-text">2 - 1</div>
          <div class="match-status">72' မိနစ်</div>
        </div>
        <div class="team right">
          <span>Chelsea</span>
          <div class="team-badge">🔵</div>
        </div>
      </div>

      <!-- Match 2 -->
      <div class="match-card">
        <div class="team">
          <div class="team-badge">⚪</div>
          <span>Real Madrid</span>
        </div>
        <div class="score-box">
          <div class="score-text">3 - 3</div>
          <div class="match-status">88' မိနစ်</div>
        </div>
        <div class="team right">
          <span>Man City</span>
          <div class="team-badge">🩵</div>
        </div>
      </div>

      <div class="section-title">
        <i class="fa-regular fa-clock" style="color: #38bdf8;"></i> လာမည့် ပွဲစဉ်များ (Upcoming)
      </div>

      <!-- Upcoming Match -->
      <div class="match-card">
        <div class="team">
          <div class="team-badge">🔴</div>
          <span>Liverpool</span>
        </div>
        <div class="score-box">
          <div class="score-text" style="font-size: 13px; color: #94a3b8;">11:30 PM</div>
          <div style="font-size: 9px; color: #64748b;">ယနေ့ည</div>
        </div>
        <div class="team right">
          <span>Man United</span>
          <div class="team-badge">👹</div>
        </div>
      </div>
    </div>

    <!-- Standings Table Section -->
    <div id="section-table">
      <div class="section-title">
        <i class="fa-solid fa-list-ol" style="color: #10b981;"></i> ပရီးမီးယားလိဂ် အမှတ်ပေးဇယား
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>အဆင့်</th>
              <th style="text-align: left;">အသင်း</th>
              <th>ပွဲ</th>
              <th>နိုင်</th>
              <th>ဂိုးကွာ</th>
              <th>ရမှတ်</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="color:#10b981; font-weight:bold;">1</td>
              <td class="team-col">🔴 Arsenal</td>
              <td>28</td>
              <td>20</td>
              <td>+38</td>
              <td style="font-weight:bold; color:#38bdf8;">64</td>
            </tr>
            <tr>
              <td style="color:#10b981; font-weight:bold;">2</td>
              <td class="team-col">🔴 Liverpool</td>
              <td>28</td>
              <td>19</td>
              <td>+35</td>
              <td style="font-weight:bold; color:#38bdf8;">63</td>
            </tr>
            <tr>
              <td style="color:#10b981; font-weight:bold;">3</td>
              <td class="team-col">🩵 Man City</td>
              <td>28</td>
              <td>19</td>
              <td>+34</td>
              <td style="font-weight:bold; color:#38bdf8;">63</td>
            </tr>
            <tr>
              <td style="color:#38bdf8;">4</td>
              <td class="team-col">Aston Villa</td>
              <td>28</td>
              <td>17</td>
              <td>+18</td>
              <td style="font-weight:bold; color:#38bdf8;">55</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Football News Section -->
    <div id="section-news">
      <div class="section-title">
        <i class="fa-solid fa-newspaper" style="color: #f59e0b;"></i> နောက်ဆုံးရ ဘောလုံးသတင်းများ
      </div>

      <div class="news-card">
        <div class="news-thumb"><i class="fa-solid fa-arrows-rotate"></i></div>
        <div class="news-info">
          <span class="news-tag">အပြောင်းအရွှေ့</span>
          <span class="news-title">ကစားသမားသစ် ခေါ်ယူရန် ဥရောပထိပ်သီးအသင်းကြီးများ မျက်စိကျနေ</span>
        </div>
      </div>

      <div class="news-card">
        <div class="news-thumb"><i class="fa-solid fa-trophy"></i></div>
        <div class="news-info">
          <span class="news-tag">ချန်ပီယံလိဂ်</span>
          <span class="news-title">ကွာတားဖိုင်နယ် ပွဲစဉ်များ မဲခွဲပွဲ ရလဒ်များနှင့် သုံးသပ်ချက်</span>
        </div>
      </div>
    </div>

  </div>

  <script>
    // Tab filtering logic
    function filterSection(type) {
      const btns = document.querySelectorAll('.tab-btn');
      btns.forEach(b => b.classList.remove('active'));
      event.target.classList.add('active');

      const matches = document.getElementById('section-matches');
      const table = document.getElementById('section-table');
      const news = document.getElementById('section-news');

      if (type === 'all') {
        matches.style.display = 'block';
        table.style.display = 'block';
        news.style.display = 'block';
      } else if (type === 'matches') {
        matches.style.display = 'block';
        table.style.display = 'none';
        news.style.display = 'none';
      } else if (type === 'table') {
        matches.style.display = 'none';
        table.style.display = 'block';
        news.style.display = 'none';
      } else if (type === 'news') {
        matches.style.display = 'none';
        table.style.display = 'none';
        news.style.display = 'block';
      }
    }
  </script>
</body>
</html>
